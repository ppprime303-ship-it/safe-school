# SAFE SCHOOL Replit 설정 (미검증: Replit에서 처음 가져온 뒤 동작을 확인해야 합니다)
# Agent 없이 Run 버튼 = `npm run dev`(화면+API, 포트 5000)
modules = ["nodejs-22", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5097
externalPort = 3002

[[ports]]
localPort = 5098
externalPort = 3001

[[ports]]
localPort = 5099
externalPort = 3000

# 배포: 빌드 후, 실행할 때 마이그레이션(데이터 삭제 없음)을 적용하고 서버를 켭니다.
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "(npm ci || npm install) && npm run build"]
run = ["sh", "-c", "npx prisma migrate deploy && npm start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
