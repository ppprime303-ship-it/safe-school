# 환경변수 목록입니다. 실제 값은 Replit의 Secrets(자물쇠 아이콘)에 넣고, 이 파일에는 적지 마세요.

# Replit에서 PostgreSQL을 추가하면 자동으로 생깁니다.
DATABASE_URL=

# 서버 포트(Replit 기본 5000)
PORT=5000

# 로그인 세션 서명용 비밀키(32자 이상 무작위). STEP 2부터 사용, 운영 배포에는 필수
SESSION_SECRET=

# 데모 학교 테스트 계정 비밀번호(12자 이상). `npm run db:seed` 에서 사용
DEMO_PASSWORD=

# 배포 주소(예: https://safe-school.replit.app). 초대 메일 링크에 사용(STEP 2)
APP_BASE_URL=

# (선택) 테스트 DB를 따로 쓰려면 지정. 비우면 DATABASE_URL의 safeschool_test 스키마를 사용
TEST_DATABASE_URL=

# 학교알리미 OpenAPI 인증키(학교 검색·공시자료). schoolinfo.go.kr 에서 무료 발급
# 비우면 저장된 학교 목록으로만 검색합니다.
SCHOOLINFO_API_KEY=

# 인증코드 메일 발송: gmail(GMAIL_SMTP_USER·GMAIL_SMTP_APP_PASSWORD), resend(MAIL_API_KEY·MAIL_FROM), manual(운영자 수동 전달) 또는 console(개발·테스트 전용 모의 발송, 운영에서는 무시)
# 비우면 인증코드를 보낼 수 없습니다(보낸 것처럼 표시하지 않음).
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# 학년별 공시자료(학교알리미 apiType 09) 사용: 실제 응답 필드 확인(npm run schoolinfo:verify) 후에만 enabled
SCHOOLINFO_GRADE_DATA=

# 학교알리미 인증키가 시군구 코드(sggCode)를 반드시 요구하면 true. 공식 페이지는 '선택'(2026-10-27 확인)
SCHOOLINFO_SGG_REQUIRED=

# 나이스 교육정보 개방 포털(open.neis.go.kr) 인증키 — 공개 교육정보(학교기본정보) 조회 전용. 비우면 호출하지 않음
NEIS_API_KEY=
# (선택) 이 서버의 나이스 하루 호출 상한. 기본 900
NEIS_DAILY_LIMIT=

# 운영 환경에서 데모 시드 허용(시연용 배포에서만 일시적으로 true)
ALLOW_DEMO_SEED=
