# 환경변수 목록입니다. 실제 값은 Replit의 Secrets(자물쇠 아이콘)에 넣고, 이 파일에는 적지 마세요.

# Replit에서 PostgreSQL을 추가하면 자동으로 생깁니다.
DATABASE_URL=

# 서버 포트(Replit 기본 5000)
PORT=5000

# 로그인 세션 서명용 비밀키(32자 이상 무작위). STEP 2부터 사용, 운영 배포에는 필수
SESSION_SECRET=

# 데모 학교 테스트 계정 비밀번호(12자 이상). `npm run db:seed` 에서 사용
DEMO_PASSWORD=

# 배포 주소(예: https://safe-school.replit.app). 초대 메일 링크에 사용(STEP 2)
APP_BASE_URL=

# (선택) 테스트 DB를 따로 쓰려면 지정. 비우면 DATABASE_URL의 safeschool_test 스키마를 사용
TEST_DATABASE_URL=
