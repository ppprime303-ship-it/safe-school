// SAFE SCHOOL 데이터베이스 스키마 (STEP 1)
//
// 주의: CHECK 제약과 "학교당 진행 중 상황 1건" 부분 UNIQUE 인덱스는 Prisma 스키마로 표현할 수 없어
// prisma/migrations/*/migration.sql 에 직접 작성되어 있습니다.
// 새 마이그레이션은 반드시 `npx prisma migrate dev --create-only` 로 만든 뒤 SQL을 검토하고,
// 위 제약을 지우는 문장(DROP INDEX, DROP CONSTRAINT)이 없는지 확인한 다음 적용하세요.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum IdentityProvider {
  password
  epki
}

enum VerificationPurpose {
  signup
  invite
  password_reset
}

enum DeviceKind {
  personal
  shared
}

enum MemberRole {
  admin
  homeroom
  staff
}

enum MembershipStatus {
  pending
  approved
  rejected
  revoked
}

enum ApprovalMethod {
  roster
  manual
  bootstrap
}

enum AssignmentDuty {
  homeroom
  assist
  inspection
}

enum DisasterType {
  fire
  earthquake
  storm_flood
  heatwave
  fine_dust
  gas_leak
  intruder
  other
}

enum EventMode {
  real
  drill
}

enum EventStatus {
  active
  closed
}

enum EnrolledChangeReason {
  transfer_out
  transfer_in
  other
}

enum SchoolStatus {
  pending_verification
  active
  suspended
}

// 데이터 출처: 학교알리미 공시, (향후 승인 시) 나이스, 관리자 직접 입력
enum DataSource {
  schoolinfo
  neis
  manual
}

enum RegistrationStatus {
  pending_verification
  approved
  rejected
  withdrawn
}

model School {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String       @unique
  /// 사용 중단 예정: 외부 식별코드는 SchoolExternalId 사용
  neisCode       String?      @unique @map("neis_code")
  eduOfficeCode  String?      @map("edu_office_code")
  eduOfficeName  String?      @map("edu_office_name")
  schoolKindCode String?      @map("school_kind_code")
  address        String?
  joinCodeHash   String?      @unique @map("join_code_hash")
  isDemo         Boolean      @default(false) @map("is_demo")
  status         SchoolStatus @default(pending_verification)
  infoSource     DataSource   @default(manual) @map("info_source")
  infoSyncedAt   DateTime?    @map("info_synced_at") @db.Timestamptz(6)
  activatedAt    DateTime?    @map("activated_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       SchoolMembership[]
  classes           SchoolClass[]
  invitations       StaffInvitation[]
  events            DisasterEvent[]
  reportDelegations EventReportDelegation[]
  staffAlerts       StaffAlert[]
  staffPresences    StaffPresence[]
  evacuationReports EvacuationReport[]
  auditLogs         AuditLog[]
  activeSessions    Session[]
  externalIds       SchoolExternalId[]
  registrations     SchoolRegistration[]
  publicSnapshots   SchoolPublicDataSnapshot[]
  region            SchoolRegion?
  alertMatches      SchoolAlertMatch[]
  notices           SchoolNotice[]
  duties            MemberDuty[]
  drillLogs         DrillLog[]

  @@map("schools")
}

model SchoolExternalId {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  source       DataSource
  externalCode String     @map("external_code")
  linkedAt     DateTime   @default(now()) @map("linked_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([source, externalCode], map: "school_external_ids_source_code_key")
  @@unique([schoolId, source], map: "school_external_ids_school_source_key")
  @@map("school_external_ids")
}

// 학교 검색용 공공데이터 목록(등록 학교와 별개의 캐시)
model SchoolDirectoryEntry {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        DataSource
  externalCode  String     @map("external_code")
  name          String
  kindCode      String?    @map("kind_code")
  sidoCode      String?    @map("sido_code")
  /// STEP A: 학교알리미 시군구 코드(5자리). 이 시군구 단위로 받아 저장한 항목만 값이 있음(최신 여부 판단 단위)
  sggCode       String?    @map("sgg_code")
  eduOfficeName String?    @map("edu_office_name")
  address       String?
  closed        Boolean    @default(false)
  raw           Json
  syncedAt      DateTime   @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@unique([source, externalCode], map: "school_directory_entries_source_code_key")
  @@index([kindCode, sidoCode], map: "school_directory_entries_kind_sido_idx")
  @@index([kindCode, sggCode], map: "school_directory_entries_kind_sgg_idx")
  @@map("school_directory_entries")
}

// 2026-10-28 v0.1 대리 보고: 담당 교사가 보고할 수 없을 때 그 사건(훈련) 동안만 다른 교직원에게 학급 보고를 맡김
// - 사유는 연락 미확인·보고 불가·관리자 판단만(실종·부상을 시스템이 판단하지 않음). 같은 학교 승인된 교직원에게만.
// - 사건·학급당 유효한 지정은 1건(부분 UNIQUE, migration.sql). 종료·재지정·사건 종료 시 ended_at 을 남겨 이력 보존
enum DelegationReason {
  unreachable
  unable
  admin_decision
}

model EventReportDelegation {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId             String           @map("school_id") @db.Uuid
  eventId              String           @map("event_id") @db.Uuid
  classId              String           @map("class_id") @db.Uuid
  delegateMembershipId String           @map("delegate_membership_id") @db.Uuid
  originalMembershipId String?          @map("original_membership_id") @db.Uuid
  reason               DelegationReason
  basis                String?
  assignedById         String           @map("assigned_by_id") @db.Uuid
  assignedAt           DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt              DateTime?        @map("ended_at") @db.Timestamptz(6)
  endedById            String?          @map("ended_by_id") @db.Uuid
  endReason            String?          @map("end_reason")

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event       DisasterEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass       @relation(fields: [classId], references: [id], onDelete: Restrict)
  delegate    SchoolMembership  @relation("DelegationDelegate", fields: [delegateMembershipId], references: [id], onDelete: Restrict)
  original    SchoolMembership? @relation("DelegationOriginal", fields: [originalMembershipId], references: [id], onDelete: SetNull)
  assignedBy  User              @relation("DelegationAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy     User?             @relation("DelegationEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([eventId, delegateMembershipId], map: "event_report_delegations_event_delegate_idx")
  @@map("event_report_delegations")
}

// STEP D 플랫폼 운영관리자(학교 소속과 별개): 신규 학교 등록 승인만 담당. 부여·회수는 서버 셸 CLI(scripts/operator.ts)로만.
// 회수해도 행을 지우지 않고 revoked_at 을 남깁니다(이력). 사용자당 '유효한 부여'는 1건(부분 UNIQUE, migration.sql)
model PlatformOperator {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  grantedAt    DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy    String    @map("granted_by")
  grantReason  String    @map("grant_reason")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by")
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "platform_operators_user_idx")
  @@map("platform_operators")
}

// 최초 학교 등록 신청과 관리자 자격 확인. 학교당 대기 1건·승인 1건(부분 UNIQUE, migration.sql)
model SchoolRegistration {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String             @map("school_id") @db.Uuid
  applicantUserId    String             @map("applicant_user_id") @db.Uuid
  applicantPosition  String?            @map("applicant_position")
  status             RegistrationStatus @default(pending_verification)
  verificationMethod String?            @map("verification_method")
  verificationNote   String?            @map("verification_note")
  reviewedBy         String?            @map("reviewed_by")
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicant User   @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)

  @@index([applicantUserId], map: "school_registrations_applicant_idx")
  @@map("school_registrations")
}

// 공시자료 스냅숏: 출처·공시연도·기준일과 원본을 보관. 운영 데이터를 자동으로 덮어쓰지 않음
model SchoolPublicDataSnapshot {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  source         DataSource
  dataset        String
  apiType        String?    @map("api_type")
  disclosureYear Int?       @map("disclosure_year")
  baseDate       DateTime?  @map("base_date") @db.Date
  sourceUrl      String     @map("source_url")
  payload        Json
  parsed         Json?
  payloadHash    String     @map("payload_hash")
  fetchedAt      DateTime   @default(now()) @map("fetched_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, source, dataset, payloadHash], map: "school_public_data_snapshots_dedupe_key")
  @@index([schoolId, dataset, fetchedAt(sort: Desc)], map: "school_public_data_snapshots_latest_idx")
  @@map("school_public_data_snapshots")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  displayName     String     @map("display_name")
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities         UserIdentity[]
  verifications      EmailVerification[]
  sessions           Session[]
  memberships        SchoolMembership[]           @relation("MembershipUser")
  approvedMembers    SchoolMembership[]           @relation("MembershipApprover")
  invitationsCreated StaffInvitation[]
  eventsCreated      DisasterEvent[]              @relation("EventCreator")
  eventsClosed       DisasterEvent[]              @relation("EventCloser")
  eventTypesAdded    DisasterEventType[]
  reports            EvacuationReport[]
  reportRevisions    EvacuationReportRevision[]
  auditLogs          AuditLog[]
  registrations      SchoolRegistration[]
  classesConfirmed   SchoolClass[]                @relation("ClassEnrolledConfirmer")
  confirmedRegions   SchoolRegion[]               @relation("RegionConfirmer")
  alertReads         AlertRead[]
  noticesCreated     SchoolNotice[]               @relation("NoticeCreator")
  noticesUpdated     SchoolNotice[]               @relation("NoticeUpdater")
  platformOperatorGrants PlatformOperator[]
  delegationsAssigned EventReportDelegation[] @relation("DelegationAssigner")
  delegationsEnded    EventReportDelegation[] @relation("DelegationEnder")
  noticeRevisions    SchoolNoticeRevision[]
  noticeRecords      NoticeHandlingRecord[]
  dutiesGranted      MemberDuty[]                 @relation("DutyGranter")
  dutiesEnded        MemberDuty[]                 @relation("DutyEnder")
  drillLogsCreated   DrillLog[]                   @relation("DrillLogCreator")
  drillLogsUpdated   DrillLog[]                   @relation("DrillLogUpdater")
  drillLogRevisions  DrillLogRevision[]

  @@map("users")
}

model UserIdentity {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject")
  linkedAt        DateTime         @default(now()) @map("linked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "user_identities_provider_subject_key")
  @@index([userId])
  @@map("user_identities")
}

model EmailVerification {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(6)
  attempts   Int                 @default(0)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "email_verifications_user_purpose_idx")
  @@map("email_verifications")
}

model Session {
  id             String     @id // 세션 토큰의 해시값
  userId         String     @map("user_id") @db.Uuid
  activeSchoolId String?    @map("active_school_id") @db.Uuid
  deviceKind     DeviceKind @map("device_kind")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime?  @map("idle_expires_at") @db.Timestamptz(6)
  reauthAt       DateTime?  @map("reauth_at") @db.Timestamptz(6)
  userAgent      String?    @map("user_agent")
  ip             String?

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchool School? @relation(fields: [activeSchoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SchoolMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(pending)
  approvalMethod ApprovalMethod?  @map("approval_method")
  approvedById   String?          @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 2026-10-28 가입 신청 정보(권한 아님): 신청한 담당 업무 키(shared/joinRequest.ts), 희망 학급, 메모. 승인·배정은 학교 관리자가 따로 확정
  requestedDuties String[]        @default([]) @map("requested_duties")
  requestedClass  String?         @map("requested_class")
  requestNote     String?         @map("request_note")
  /// 2026-10-28 v0.1 교직원 구분 신청(teacher·principal·vice_principal·other) — 권한 아님(교장·교감 직책은 운영자 확인으로만)
  requestedPosition String?       @map("requested_position")

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user        User              @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User?             @relation("MembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assignments ClassAssignment[]
  duties      MemberDuty[]
  delegationsAsDelegate EventReportDelegation[] @relation("DelegationDelegate")
  delegationsAsOriginal EventReportDelegation[] @relation("DelegationOriginal")
  staffAlerts           StaffAlert[]
  staffPresences        StaffPresence[]

  @@unique([schoolId, userId], map: "school_memberships_school_user_key")
  @@index([schoolId, status], map: "school_memberships_school_status_idx")
  @@map("school_memberships")
}

model SchoolClass {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String     @map("school_id") @db.Uuid
  schoolYear            Int        @map("school_year")
  grade                 Int
  classNo               Int        @map("class_no")
  label                 String
  /// 재적: 관리자가 확인하기 전에는 비어 있을 수 있음(학교알리미는 학년 합계만 제공)
  enrolledCount         Int?       @map("enrolled_count")
  origin                DataSource @default(manual)
  enrolledSource        DataSource @default(manual) @map("enrolled_source")
  enrolledConfirmedAt   DateTime?  @map("enrolled_confirmed_at") @db.Timestamptz(6)
  enrolledConfirmedById String?    @map("enrolled_confirmed_by_id") @db.Uuid
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrolledConfirmedBy   User?                  @relation("ClassEnrolledConfirmer", fields: [enrolledConfirmedById], references: [id], onDelete: SetNull)
  assignments           ClassAssignment[]
  invitationAssignments InvitationAssignment[]
  reports               EvacuationReport[]
  reportDelegations     EventReportDelegation[]

  @@unique([schoolId, schoolYear, grade, classNo], map: "classes_school_year_grade_class_key")
  @@map("classes")
}

model ClassAssignment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String         @map("membership_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  duty         AssignmentDuty
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([membershipId, classId, duty], map: "class_assignments_member_class_duty_key")
  @@index([classId])
  @@map("class_assignments")
}

model StaffInvitation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String     @map("school_id") @db.Uuid
  email       String
  displayName String     @map("display_name")
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments InvitationAssignment[]

  @@unique([schoolId, email], map: "staff_invitations_school_email_key")
  @@map("staff_invitations")
}

model InvitationAssignment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String         @map("invitation_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  duty         AssignmentDuty

  invitation  StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([invitationId, classId, duty], map: "invitation_assignments_inv_class_duty_key")
  @@map("invitation_assignments")
}

model DisasterEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  primaryType DisasterType @map("primary_type")
  mode        EventMode
  status      EventStatus  @default(active)
  location    String?
  evacPlace   String?      @map("evac_place")
  message     String?
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdById String?      @map("created_by_id") @db.Uuid
  closedById  String?      @map("closed_by_id") @db.Uuid
  drillPlanId String?      @map("drill_plan_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User?               @relation("EventCloser", fields: [closedById], references: [id], onDelete: SetNull)
  types     DisasterEventType[]
  reports   EvacuationReport[]
  drillLog  DrillLog?
  reportDelegations EventReportDelegation[]
  staffAlerts       StaffAlert[]
  staffPresences    StaffPresence[]

  // 부분 UNIQUE 인덱스 disaster_events_one_active_per_school 은 migration.sql 에 있습니다.
  @@index([schoolId, startedAt(sort: Desc)], map: "disaster_events_school_started_idx")
  @@map("disaster_events")
}

model DisasterEventType {
