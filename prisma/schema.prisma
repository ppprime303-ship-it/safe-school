}

// ───────────── STEP 3-B 공식 경보 ─────────────
// 마이그레이션 20261021000000_official_alerts 에 CHECK 제약과 원문 수정·삭제 금지 트리거가 있습니다.

enum AlertProvider {
  mock
  mois_cbs
}

enum AlertKind {
  disaster_text
  weather
  air_quality
  other
}

enum AlertSeverity {
  info
  advisory
  warning
  emergency
}

enum AlertMsgType {
  new
  update
  cancel
}

enum AlertMatchResult {
  target
  non_target
  undetermined
}

enum RegionSource {
  address_parsed
  admin
}

enum CollectionStatus {
  success
  failed
  skipped
}

/// 공식 경보 원문(받은 그대로, 수정·삭제 불가)
model OfficialAlert {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      AlertProvider
  externalId    String        @map("external_id")
  isMock        Boolean       @map("is_mock")
  kind          AlertKind
  severity      AlertSeverity
  msgType       AlertMsgType  @default(new) @map("msg_type")
  refExternalId String?       @map("ref_external_id")
  issuer        String
  title         String?
  body          String
  areasRaw      String        @map("areas_raw")
  /// [{ sido: string, sigungu: string | null }] — sido "전국"은 모든 지역
  areas         Json
  issuedAt      DateTime      @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime?     @map("expires_at") @db.Timestamptz(6)
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  contentHash   String        @map("content_hash")
  raw           Json

  matches        SchoolAlertMatch[] @relation("MatchAlert")
  duplicatesOf   SchoolAlertMatch[] @relation("MatchDuplicateOf")
  notices        SchoolNotice[]

  @@unique([provider, externalId], map: "official_alerts_provider_external_key")
  @@index([contentHash, issuedAt], map: "official_alerts_content_issued_idx")
  @@index([issuedAt(sort: Desc)], map: "official_alerts_issued_idx")
  @@map("official_alerts")
}

model AlertCollectionRun {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           AlertProvider
  status             CollectionStatus
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?        @map("finished_at") @db.Timestamptz(6)
  attempts           Int              @default(1)
  fetchedCount       Int              @default(0) @map("fetched_count")
  newCount           Int              @default(0) @map("new_count")
  duplicateCount     Int              @default(0) @map("duplicate_count")
  matchedSchoolCount Int              @default(0) @map("matched_school_count")
  cursor             String?
  errorMessage       String?          @map("error_message")

  @@index([provider, startedAt(sort: Desc)], map: "alert_collection_runs_provider_started_idx")
  @@map("alert_collection_runs")
}

model SchoolRegion {
  schoolId      String       @id @map("school_id") @db.Uuid
  sido          String
  sigungu       String?
  source        RegionSource
  confirmedAt   DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  confirmedById String?      @map("confirmed_by_id") @db.Uuid
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  confirmedBy User?  @relation("RegionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@map("school_regions")
}

model SchoolAlertMatch {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String           @map("school_id") @db.Uuid
  alertId            String           @map("alert_id") @db.Uuid
  result             AlertMatchResult
  reason             String
  duplicateOfAlertId String?          @map("duplicate_of_alert_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  alert       OfficialAlert  @relation("MatchAlert", fields: [alertId], references: [id], onDelete: Restrict)
  duplicateOf OfficialAlert? @relation("MatchDuplicateOf", fields: [duplicateOfAlertId], references: [id], onDelete: Restrict)
  reads       AlertRead[]
  notices     SchoolNotice[]

  @@unique([schoolId, alertId], map: "school_alert_matches_school_alert_key")
  @@index([schoolId, createdAt(sort: Desc)], map: "school_alert_matches_school_created_idx")
  @@map("school_alert_matches")
}

model AlertRead {
  userId  String   @map("user_id") @db.Uuid
  matchId String   @map("match_id") @db.Uuid
  readAt  DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  match SchoolAlertMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([userId, matchId])
  @@map("alert_reads")
}

// ───────────── STEP 3-C 재난안전 안내문 작성 지원 ─────────────
// 마이그레이션 20261022000000_school_notices 에 CHECK 제약과 트리거가 있습니다.
// - 같은 학교의 '대상'·대표 경보에만 연결, 삭제 금지, 취소 후 변경 금지, 판 번호 +1 강제
// - 수정 이력은 DB 트리거가 자동 기록(앱에서 직접 쓰지 않음)
// - 재사용(source_notice_id): 같은 학교의 취소된 안내문만 원본, 같은 원본의 작성 중 초안은 1건만
// 실제 발송·승인·모의 발송·학부모 연락처는 다루지 않습니다.

enum NoticeStatus {
  draft
  completed
  cancelled
}

/// 처리 이력의 기록용 채널 분류(외부 서비스와 연결 없음)
enum NoticeChannelLabel {
  sms
  school_app
  kakao
  other
}

model SchoolNotice {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  alertId        String       @map("alert_id") @db.Uuid
  exampleKey     String?      @map("example_key")
  exampleVersion Int?         @map("example_version")
  title          String
  body           String
  status         NoticeStatus @default(draft)
  version        Int          @default(1)
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?      @map("cancel_reason")
  /// 재사용 원본(같은 학교의 취소된 안내문). 복합 외래키 (source_notice_id, school_id)는 SQL에만 있음
  sourceNoticeId String?      @map("source_notice_id") @db.Uuid

  match     SchoolAlertMatch       @relation(fields: [schoolId, alertId], references: [schoolId, alertId], onDelete: Restrict, onUpdate: Restrict, map: "school_notices_match_fkey")
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, map: "school_notices_school_fkey")
  alert     OfficialAlert          @relation(fields: [alertId], references: [id], onDelete: Restrict, map: "school_notices_alert_fkey")
  createdBy User?                  @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "school_notices_creator_fkey")
  updatedBy User?                  @relation("NoticeUpdater", fields: [updatedById], references: [id], onDelete: SetNull, map: "school_notices_updater_fkey")
  revisions SchoolNoticeRevision[]
  records   NoticeHandlingRecord[]

  @@unique([id, schoolId], map: "school_notices_id_school_key")
  @@index([schoolId, alertId], map: "school_notices_school_alert_idx")
  @@index([schoolId, updatedAt(sort: Desc)], map: "school_notices_school_updated_idx")
  @@map("school_notices")
}

/// 안내문 수정 이력(DB 트리거만 기록, 수정·삭제 불가)
model SchoolNoticeRevision {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId    String       @map("notice_id") @db.Uuid
  version     Int
  title       String
  body        String
  status      NoticeStatus
  exampleKey  String?      @map("example_key")
  changedById String?      @map("changed_by_id") @db.Uuid
  changedAt   DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)

  notice    SchoolNotice @relation(fields: [noticeId], references: [id], onDelete: Restrict, map: "school_notice_revisions_notice_fkey")
  changedBy User?        @relation(fields: [changedById], references: [id], onDelete: SetNull, map: "school_notice_revisions_changer_fkey")

  @@unique([noticeId, version], map: "school_notice_revisions_notice_version_key")
  @@map("school_notice_revisions")
}

/// 선택적 처리 이력(교직원 직접 입력, 실제 발송·수신 확인·공식 결재 아님, 개인정보 없음)
model NoticeHandlingRecord {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId         String              @map("notice_id") @db.Uuid
  schoolId         String              @map("school_id") @db.Uuid
  channel          NoticeChannelLabel?
  channelNote      String?             @map("channel_note")
  audienceCategory String?             @map("audience_category")
  sentByTeacher    Boolean             @default(false) @map("sent_by_teacher")
  sentAt           DateTime?           @map("sent_at") @db.Timestamptz(6)
  memo             String?
  recordedById     String?             @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  voidedAt         DateTime?           @map("voided_at") @db.Timestamptz(6)
  voidReason       String?             @map("void_reason")

  notice     SchoolNotice @relation(fields: [noticeId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict, map: "notice_handling_records_notice_school_fkey")
  recordedBy User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull, map: "notice_handling_records_recorder_fkey")

  @@index([noticeId, recordedAt], map: "notice_handling_records_notice_idx")
  @@map("notice_handling_records")
}

// ───────────── STEP 3-D 직책·업무(겸임) · 비상대피훈련일지 ─────────────
// 마이그레이션 20261023000000_duties_drill_logs 에 CHECK·부분 UNIQUE·트리거가 있습니다.
// - 교장(1명)·교감(최대 2명): 플랫폼 운영자 확인으로만 등록(granted_via=platform_operator, 확인 방법 필수)
// - 안전업무 담당·앱 운영담당: 여러 명, 겸임 가능. 종료만 가능(삭제·되살리기 불가)
// - 훈련일지: 종료된 모의훈련에만, 이벤트당 1건, 판 번호 +1 강제, 수정 이력 DB 자동 기록

enum StaffDuty {
  principal
  vice_principal
  safety_officer
  app_operator
}

enum DutyGrantVia {
  school_app
  platform_operator
}

model MemberDuty {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String       @map("school_id") @db.Uuid
  membershipId       String       @map("membership_id") @db.Uuid
  duty               StaffDuty
  isActing           Boolean      @default(false) @map("is_acting")
  grantedVia         DutyGrantVia @map("granted_via")
  grantedById        String?      @map("granted_by_id") @db.Uuid
  grantedByLabel     String?      @map("granted_by_label")
  verificationMethod String?      @map("verification_method")
  note               String?
  startedAt          DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?    @map("ended_at") @db.Timestamptz(6)
  endedById          String?      @map("ended_by_id") @db.Uuid
  endedByLabel       String?      @map("ended_by_label")
  endReason          String?      @map("end_reason")

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, map: "member_duties_school_fkey")
  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict, map: "member_duties_membership_fkey")
  grantedBy  User?            @relation("DutyGranter", fields: [grantedById], references: [id], onDelete: SetNull, map: "member_duties_granted_by_fkey")
  endedBy    User?            @relation("DutyEnder", fields: [endedById], references: [id], onDelete: SetNull, map: "member_duties_ended_by_fkey")

  @@map("member_duties")
}

enum DrillLogStatus {
  draft
  completed
}

model DrillLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String         @map("school_id") @db.Uuid
  eventId      String         @unique(map: "drill_logs_event_key") @map("event_id") @db.Uuid
  formKey      String         @default("evacuation_drill") @map("form_key")
  formVersion  Int            @default(1) @map("form_version")
  status       DrillLogStatus @default(draft)
  version      Int            @default(1)
  autoSnapshot Json           @map("auto_snapshot")
  autoTakenAt  DateTime       @default(now()) @map("auto_taken_at") @db.Timestamptz(6)
  manual       Json
  createdById  String?        @map("created_by_id") @db.Uuid
  updatedById  String?        @map("updated_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Restrict, map: "drill_logs_school_fkey")
  event     DisasterEvent      @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "drill_logs_event_fkey")
  createdBy User?              @relation("DrillLogCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "drill_logs_creator_fkey")
  updatedBy User?              @relation("DrillLogUpdater", fields: [updatedById], references: [id], onDelete: SetNull, map: "drill_logs_updater_fkey")
  revisions DrillLogRevision[]

  @@index([schoolId, updatedAt(sort: Desc)], map: "drill_logs_school_updated_idx")
  @@map("drill_logs")
}

/// 훈련일지 수정 이력(DB 트리거만 기록, 수정·삭제 불가)
model DrillLogRevision {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drillLogId   String         @map("drill_log_id") @db.Uuid
  version      Int
  status       DrillLogStatus
  autoSnapshot Json           @map("auto_snapshot")
  manual       Json
  changedById  String?        @map("changed_by_id") @db.Uuid
  changedAt    DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)

  drillLog  DrillLog @relation(fields: [drillLogId], references: [id], onDelete: Restrict, map: "drill_log_revisions_log_fkey")
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull, map: "drill_log_revisions_changer_fkey")

  @@unique([drillLogId, version], map: "drill_log_revisions_log_version_key")
  @@map("drill_log_revisions")
}

// ───────────── Beta PILOT 2 Phase 2 교직원 앱 내 알림·소재 보고 ─────────────
// 마이그레이션 20261030000000_staff_presence 에 CHECK 제약(교내 위치 규칙·길이)과 이력 수정 금지 트리거가 있습니다.
// 개인 위치정보: 교외는 위치를 저장하지 않고, 감사 기록에도 위치 내용을 넣지 않습니다(보관 기간 미확정 — 사건 단위 삭제 가능 구조).

enum PresenceLocation {
  on_campus
  off_campus
}

/// 대피 지원 가능 여부. unsure = 본인이 '확인 필요'로 응답(미응답과 다름)
enum PresenceAvailability {
  available
  unavailable
  unsure
}

/// 교내 장소 분류(화면 선택 목록). other 는 상세 위치 필수
enum PresencePlace {
  classroom
  staff_room
  nurse_room
  cafeteria
  gym
  playground
  hallway
  stairs
  special_room
  other
}

/// 사건별·교직원별 앱 내 알림. created_at(생성) ≠ 전달, read_at = 본인이 앱에서 확인한 시각
model StaffAlert {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event      DisasterEvent    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([eventId, membershipId], map: "staff_alerts_event_member_key")
  @@index([membershipId, readAt], map: "staff_alerts_member_read_idx")
  @@map("staff_alerts")
}

/// 사건별·교직원별 현재 소재(본인만 작성). 교내면 장소 분류 필수, 교외면 장소 저장 안 함
model StaffPresence {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String               @map("school_id") @db.Uuid
  eventId          String               @map("event_id") @db.Uuid
  membershipId     String               @map("membership_id") @db.Uuid
  location         PresenceLocation
  placeCategory    PresencePlace?       @map("place_category")
  placeDetail      String?              @map("place_detail")
  availability     PresenceAvailability
  version          Int                  @default(1)
  firstRespondedAt DateTime             @default(now()) @map("first_responded_at") @db.Timestamptz(6)
  respondedAt      DateTime             @default(now()) @map("responded_at") @db.Timestamptz(6)

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event      DisasterEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  membership SchoolMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  history    StaffPresenceHistory[]

  @@unique([eventId, membershipId], map: "staff_presences_event_member_key")
  @@index([schoolId, eventId], map: "staff_presences_school_event_idx")
  @@map("staff_presences")
}

/// 소재 응답 이력(판마다 1행, 본인 변경만). 수정은 트리거가 거부, 삭제는 보관 정책 확정 후 승인된 절차로만
model StaffPresenceHistory {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  presenceId     String               @map("presence_id") @db.Uuid
  version        Int
  location       PresenceLocation
  placeCategory  PresencePlace?       @map("place_category")
  placeDetail    String?              @map("place_detail")
  availability   PresenceAvailability
  idempotencyKey String               @unique(map: "staff_presence_history_idempotency_key") @map("idempotency_key")
  changedAt      DateTime             @default(now()) @map("changed_at") @db.Timestamptz(6)

  presence StaffPresence @relation(fields: [presenceId], references: [id], onDelete: Restrict)

  @@unique([presenceId, version], map: "staff_presence_history_presence_version_key")
  @@map("staff_presence_history")
}
