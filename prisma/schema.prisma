// SAFE SCHOOL 데이터베이스 스키마 (STEP 1)
//
// 주의: CHECK 제약과 "학교당 진행 중 상황 1건" 부분 UNIQUE 인덱스는 Prisma 스키마로 표현할 수 없어
// prisma/migrations/*/migration.sql 에 직접 작성되어 있습니다.
// 새 마이그레이션은 반드시 `npx prisma migrate dev --create-only` 로 만든 뒤 SQL을 검토하고,
// 위 제약을 지우는 문장(DROP INDEX, DROP CONSTRAINT)이 없는지 확인한 다음 적용하세요.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum IdentityProvider {
  password
  epki
}

enum VerificationPurpose {
  signup
  invite
  password_reset
}

enum DeviceKind {
  personal
  shared
}

enum MemberRole {
  admin
  homeroom
  staff
}

enum MembershipStatus {
  pending
  approved
  rejected
  revoked
}

enum ApprovalMethod {
  roster
  manual
  bootstrap
}

enum AssignmentDuty {
  homeroom
  assist
  inspection
}

enum DisasterType {
  fire
  earthquake
  storm_flood
  heatwave
  fine_dust
  gas_leak
  intruder
  other
}

enum EventMode {
  real
  drill
}

enum EventStatus {
  active
  closed
}

enum EnrolledChangeReason {
  transfer_out
  transfer_in
  other
}

enum SchoolStatus {
  pending_verification
  active
  suspended
}

// 데이터 출처: 학교알리미 공시, (향후 승인 시) 나이스, 관리자 직접 입력
enum DataSource {
  schoolinfo
  neis
  manual
}

enum RegistrationStatus {
  pending_verification
  approved
  rejected
  withdrawn
}

model School {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String       @unique
  /// 사용 중단 예정: 외부 식별코드는 SchoolExternalId 사용
  neisCode       String?      @unique @map("neis_code")
  eduOfficeCode  String?      @map("edu_office_code")
  eduOfficeName  String?      @map("edu_office_name")
  schoolKindCode String?      @map("school_kind_code")
  address        String?
  joinCodeHash   String?      @unique @map("join_code_hash")
  isDemo         Boolean      @default(false) @map("is_demo")
  status         SchoolStatus @default(pending_verification)
  infoSource     DataSource   @default(manual) @map("info_source")
  infoSyncedAt   DateTime?    @map("info_synced_at") @db.Timestamptz(6)
  activatedAt    DateTime?    @map("activated_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       SchoolMembership[]
  classes           SchoolClass[]
  invitations       StaffInvitation[]
  events            DisasterEvent[]
  evacuationReports EvacuationReport[]
  auditLogs         AuditLog[]
  activeSessions    Session[]
  externalIds       SchoolExternalId[]
  registrations     SchoolRegistration[]
  publicSnapshots   SchoolPublicDataSnapshot[]
  region            SchoolRegion?
  alertMatches      SchoolAlertMatch[]
  notices           SchoolNotice[]

  @@map("schools")
}

model SchoolExternalId {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  source       DataSource
  externalCode String     @map("external_code")
  linkedAt     DateTime   @default(now()) @map("linked_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([source, externalCode], map: "school_external_ids_source_code_key")
  @@unique([schoolId, source], map: "school_external_ids_school_source_key")
  @@map("school_external_ids")
}

// 학교 검색용 공공데이터 목록(등록 학교와 별개의 캐시)
model SchoolDirectoryEntry {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        DataSource
  externalCode  String     @map("external_code")
  name          String
  kindCode      String?    @map("kind_code")
  sidoCode      String?    @map("sido_code")
  eduOfficeName String?    @map("edu_office_name")
  address       String?
  closed        Boolean    @default(false)
  raw           Json
  syncedAt      DateTime   @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@unique([source, externalCode], map: "school_directory_entries_source_code_key")
  @@index([kindCode, sidoCode], map: "school_directory_entries_kind_sido_idx")
  @@map("school_directory_entries")
}

// 최초 학교 등록 신청과 관리자 자격 확인. 학교당 대기 1건·승인 1건(부분 UNIQUE, migration.sql)
model SchoolRegistration {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String             @map("school_id") @db.Uuid
  applicantUserId    String             @map("applicant_user_id") @db.Uuid
  applicantPosition  String?            @map("applicant_position")
  status             RegistrationStatus @default(pending_verification)
  verificationMethod String?            @map("verification_method")
  verificationNote   String?            @map("verification_note")
  reviewedBy         String?            @map("reviewed_by")
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicant User   @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)

  @@index([applicantUserId], map: "school_registrations_applicant_idx")
  @@map("school_registrations")
}

// 공시자료 스냅숏: 출처·공시연도·기준일과 원본을 보관. 운영 데이터를 자동으로 덮어쓰지 않음
model SchoolPublicDataSnapshot {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  source         DataSource
  dataset        String
  apiType        String?    @map("api_type")
  disclosureYear Int?       @map("disclosure_year")
  baseDate       DateTime?  @map("base_date") @db.Date
  sourceUrl      String     @map("source_url")
  payload        Json
  parsed         Json?
  payloadHash    String     @map("payload_hash")
  fetchedAt      DateTime   @default(now()) @map("fetched_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, source, dataset, payloadHash], map: "school_public_data_snapshots_dedupe_key")
  @@index([schoolId, dataset, fetchedAt(sort: Desc)], map: "school_public_data_snapshots_latest_idx")
  @@map("school_public_data_snapshots")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  displayName     String     @map("display_name")
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities         UserIdentity[]
  verifications      EmailVerification[]
  sessions           Session[]
  memberships        SchoolMembership[]           @relation("MembershipUser")
  approvedMembers    SchoolMembership[]           @relation("MembershipApprover")
  invitationsCreated StaffInvitation[]
  eventsCreated      DisasterEvent[]              @relation("EventCreator")
  eventsClosed       DisasterEvent[]              @relation("EventCloser")
  eventTypesAdded    DisasterEventType[]
  reports            EvacuationReport[]
  reportRevisions    EvacuationReportRevision[]
  auditLogs          AuditLog[]
  registrations      SchoolRegistration[]
  classesConfirmed   SchoolClass[]                @relation("ClassEnrolledConfirmer")
  confirmedRegions   SchoolRegion[]               @relation("RegionConfirmer")
  alertReads         AlertRead[]
  noticesCreated     SchoolNotice[]               @relation("NoticeCreator")
  noticesUpdated     SchoolNotice[]               @relation("NoticeUpdater")
  noticeRevisions    SchoolNoticeRevision[]
  noticeRecords      NoticeHandlingRecord[]

  @@map("users")
}

model UserIdentity {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject")
  linkedAt        DateTime         @default(now()) @map("linked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "user_identities_provider_subject_key")
  @@index([userId])
  @@map("user_identities")
}

model EmailVerification {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(6)
  attempts   Int                 @default(0)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "email_verifications_user_purpose_idx")
  @@map("email_verifications")
}

model Session {
  id             String     @id // 세션 토큰의 해시값
  userId         String     @map("user_id") @db.Uuid
  activeSchoolId String?    @map("active_school_id") @db.Uuid
  deviceKind     DeviceKind @map("device_kind")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime?  @map("idle_expires_at") @db.Timestamptz(6)
  reauthAt       DateTime?  @map("reauth_at") @db.Timestamptz(6)
  userAgent      String?    @map("user_agent")
  ip             String?

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchool School? @relation(fields: [activeSchoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SchoolMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(pending)
  approvalMethod ApprovalMethod?  @map("approval_method")
  approvedById   String?          @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user        User              @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User?             @relation("MembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assignments ClassAssignment[]

  @@unique([schoolId, userId], map: "school_memberships_school_user_key")
  @@index([schoolId, status], map: "school_memberships_school_status_idx")
  @@map("school_memberships")
}

model SchoolClass {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String     @map("school_id") @db.Uuid
  schoolYear            Int        @map("school_year")
  grade                 Int
  classNo               Int        @map("class_no")
  label                 String
  /// 재적: 관리자가 확인하기 전에는 비어 있을 수 있음(학교알리미는 학년 합계만 제공)
  enrolledCount         Int?       @map("enrolled_count")
  origin                DataSource @default(manual)
  enrolledSource        DataSource @default(manual) @map("enrolled_source")
  enrolledConfirmedAt   DateTime?  @map("enrolled_confirmed_at") @db.Timestamptz(6)
  enrolledConfirmedById String?    @map("enrolled_confirmed_by_id") @db.Uuid
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrolledConfirmedBy   User?                  @relation("ClassEnrolledConfirmer", fields: [enrolledConfirmedById], references: [id], onDelete: SetNull)
  assignments           ClassAssignment[]
  invitationAssignments InvitationAssignment[]
  reports               EvacuationReport[]

  @@unique([schoolId, schoolYear, grade, classNo], map: "classes_school_year_grade_class_key")
  @@map("classes")
}

model ClassAssignment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String         @map("membership_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  duty         AssignmentDuty
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([membershipId, classId, duty], map: "class_assignments_member_class_duty_key")
  @@index([classId])
  @@map("class_assignments")
}

model StaffInvitation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String     @map("school_id") @db.Uuid
  email       String
  displayName String     @map("display_name")
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments InvitationAssignment[]

  @@unique([schoolId, email], map: "staff_invitations_school_email_key")
  @@map("staff_invitations")
}

model InvitationAssignment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String         @map("invitation_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  duty         AssignmentDuty

  invitation  StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([invitationId, classId, duty], map: "invitation_assignments_inv_class_duty_key")
  @@map("invitation_assignments")
}

model DisasterEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  primaryType DisasterType @map("primary_type")
  mode        EventMode
  status      EventStatus  @default(active)
  location    String?
  evacPlace   String?      @map("evac_place")
  message     String?
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdById String?      @map("created_by_id") @db.Uuid
  closedById  String?      @map("closed_by_id") @db.Uuid
  drillPlanId String?      @map("drill_plan_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User?               @relation("EventCloser", fields: [closedById], references: [id], onDelete: SetNull)
  types     DisasterEventType[]
  reports   EvacuationReport[]

  // 부분 UNIQUE 인덱스 disaster_events_one_active_per_school 은 migration.sql 에 있습니다.
  @@index([schoolId, startedAt(sort: Desc)], map: "disaster_events_school_started_idx")
  @@map("disaster_events")
}

model DisasterEventType {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String       @map("event_id") @db.Uuid
  type      DisasterType
  note      String?
  addedById String?      @map("added_by_id") @db.Uuid
  addedAt   DateTime     @default(now()) @map("added_at") @db.Timestamptz(6)

  event   DisasterEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addedBy User?         @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([eventId, type], map: "disaster_event_types_event_type_key")
  @@map("disaster_event_types")
}

model EvacuationReport {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId              String                @map("event_id") @db.Uuid
  schoolId             String                @map("school_id") @db.Uuid
  classId              String                @map("class_id") @db.Uuid
  enrolledSnapshot     Int?                  @map("enrolled_snapshot")
  enrolledCount        Int                   @map("enrolled_count")
  enrolledChangeReason EnrolledChangeReason? @map("enrolled_change_reason")
  absentKnown          Int                   @default(0) @map("absent_known")
  evacuated            Int
  unconfirmed          Int
  injured              Int                   @default(0)
  note                 String?
  version              Int                   @default(1)
  reportedById         String?               @map("reported_by_id") @db.Uuid
  reportedAt           DateTime              @default(now()) @map("reported_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  event       DisasterEvent              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass                @relation(fields: [classId], references: [id], onDelete: Restrict)
  reportedBy  User?                      @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  revisions   EvacuationReportRevision[]

  @@unique([eventId, classId], map: "evacuation_reports_event_class_key")
  @@index([schoolId, eventId], map: "evacuation_reports_school_event_idx")
  @@map("evacuation_reports")
}

model EvacuationReportRevision {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId             String                @map("report_id") @db.Uuid
  version              Int
  enrolledCount        Int                   @map("enrolled_count")
  enrolledChangeReason EnrolledChangeReason? @map("enrolled_change_reason")
  absentKnown          Int                   @map("absent_known")
  evacuated            Int
  unconfirmed          Int
  injured              Int
  note                 String?
  changeReason         String?               @map("change_reason")
  idempotencyKey       String                @unique(map: "evacuation_report_revisions_idempotency_key") @map("idempotency_key")
  changedById          String?               @map("changed_by_id") @db.Uuid
  changedAt            DateTime              @default(now()) @map("changed_at") @db.Timestamptz(6)

  report    EvacuationReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  changedBy User?            @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([reportId, version], map: "evacuation_report_revisions_report_version_key")
  @@map("evacuation_report_revisions")
}

// 추가만 가능(수정·삭제는 DB 트리거가 거부)
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  ip          String?
  at          DateTime @default(now()) @db.Timestamptz(6)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, at(sort: Desc)], map: "audit_logs_school_at_idx")
  @@map("audit_logs")
}

// ───────────── STEP 3-B 공식 경보 ─────────────
// 마이그레이션 20261021000000_official_alerts 에 CHECK 제약과 원문 수정·삭제 금지 트리거가 있습니다.

enum AlertProvider {
  mock
  mois_cbs
}

enum AlertKind {
  disaster_text
  weather
  air_quality
  other
}

enum AlertSeverity {
  info
  advisory
  warning
  emergency
}

enum AlertMsgType {
  new
  update
  cancel
}

enum AlertMatchResult {
  target
  non_target
  undetermined
}

enum RegionSource {
  address_parsed
  admin
}

enum CollectionStatus {
  success
  failed
  skipped
}

/// 공식 경보 원문(받은 그대로, 수정·삭제 불가)
model OfficialAlert {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      AlertProvider
  externalId    String        @map("external_id")
  isMock        Boolean       @map("is_mock")
  kind          AlertKind
  severity      AlertSeverity
  msgType       AlertMsgType  @default(new) @map("msg_type")
  refExternalId String?       @map("ref_external_id")
  issuer        String
  title         String?
  body          String
  areasRaw      String        @map("areas_raw")
  /// [{ sido: string, sigungu: string | null }] — sido "전국"은 모든 지역
  areas         Json
  issuedAt      DateTime      @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime?     @map("expires_at") @db.Timestamptz(6)
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  contentHash   String        @map("content_hash")
  raw           Json

  matches        SchoolAlertMatch[] @relation("MatchAlert")
  duplicatesOf   SchoolAlertMatch[] @relation("MatchDuplicateOf")
  notices        SchoolNotice[]

  @@unique([provider, externalId], map: "official_alerts_provider_external_key")
  @@index([contentHash, issuedAt], map: "official_alerts_content_issued_idx")
  @@index([issuedAt(sort: Desc)], map: "official_alerts_issued_idx")
  @@map("official_alerts")
}

model AlertCollectionRun {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           AlertProvider
  status             CollectionStatus
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?        @map("finished_at") @db.Timestamptz(6)
  attempts           Int              @default(1)
  fetchedCount       Int              @default(0) @map("fetched_count")
  newCount           Int              @default(0) @map("new_count")
  duplicateCount     Int              @default(0) @map("duplicate_count")
  matchedSchoolCount Int              @default(0) @map("matched_school_count")
  cursor             String?
  errorMessage       String?          @map("error_message")

  @@index([provider, startedAt(sort: Desc)], map: "alert_collection_runs_provider_started_idx")
  @@map("alert_collection_runs")
}

model SchoolRegion {
  schoolId      String       @id @map("school_id") @db.Uuid
  sido          String
  sigungu       String?
  source        RegionSource
  confirmedAt   DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  confirmedById String?      @map("confirmed_by_id") @db.Uuid
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  confirmedBy User?  @relation("RegionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@map("school_regions")
}

model SchoolAlertMatch {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String           @map("school_id") @db.Uuid
  alertId            String           @map("alert_id") @db.Uuid
  result             AlertMatchResult
  reason             String
  duplicateOfAlertId String?          @map("duplicate_of_alert_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  alert       OfficialAlert  @relation("MatchAlert", fields: [alertId], references: [id], onDelete: Restrict)
  duplicateOf OfficialAlert? @relation("MatchDuplicateOf", fields: [duplicateOfAlertId], references: [id], onDelete: Restrict)
  reads       AlertRead[]
  notices     SchoolNotice[]

  @@unique([schoolId, alertId], map: "school_alert_matches_school_alert_key")
  @@index([schoolId, createdAt(sort: Desc)], map: "school_alert_matches_school_created_idx")
  @@map("school_alert_matches")
}

model AlertRead {
  userId  String   @map("user_id") @db.Uuid
  matchId String   @map("match_id") @db.Uuid
  readAt  DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  match SchoolAlertMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([userId, matchId])
  @@map("alert_reads")
}

// ───────────── STEP 3-C 재난안전 안내문 작성 지원 ─────────────
// 마이그레이션 20261022000000_school_notices 에 CHECK 제약과 트리거가 있습니다.
// - 같은 학교의 '대상'·대표 경보에만 연결, 삭제 금지, 취소 후 변경 금지, 판 번호 +1 강제
// - 수정 이력은 DB 트리거가 자동 기록(앱에서 직접 쓰지 않음)
// - 재사용(source_notice_id): 같은 학교의 취소된 안내문만 원본, 같은 원본의 작성 중 초안은 1건만
// 실제 발송·승인·모의 발송·학부모 연락처는 다루지 않습니다.

enum NoticeStatus {
  draft
  completed
  cancelled
}

/// 처리 이력의 기록용 채널 분류(외부 서비스와 연결 없음)
enum NoticeChannelLabel {
  sms
  school_app
  kakao
  other
}

model SchoolNotice {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  alertId        String       @map("alert_id") @db.Uuid
  exampleKey     String?      @map("example_key")
  exampleVersion Int?         @map("example_version")
  title          String
  body           String
  status         NoticeStatus @default(draft)
  version        Int          @default(1)
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?      @map("cancel_reason")
  /// 재사용 원본(같은 학교의 취소된 안내문). 복합 외래키 (source_notice_id, school_id)는 SQL에만 있음
  sourceNoticeId String?      @map("source_notice_id") @db.Uuid

  match     SchoolAlertMatch       @relation(fields: [schoolId, alertId], references: [schoolId, alertId], onDelete: Restrict, onUpdate: Restrict, map: "school_notices_match_fkey")
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, map: "school_notices_school_fkey")
  alert     OfficialAlert          @relation(fields: [alertId], references: [id], onDelete: Restrict, map: "school_notices_alert_fkey")
  createdBy User?                  @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "school_notices_creator_fkey")
  updatedBy User?                  @relation("NoticeUpdater", fields: [updatedById], references: [id], onDelete: SetNull, map: "school_notices_updater_fkey")
  revisions SchoolNoticeRevision[]
  records   NoticeHandlingRecord[]

  @@unique([id, schoolId], map: "school_notices_id_school_key")
  @@index([schoolId, alertId], map: "school_notices_school_alert_idx")
  @@index([schoolId, updatedAt(sort: Desc)], map: "school_notices_school_updated_idx")
  @@map("school_notices")
}

/// 안내문 수정 이력(DB 트리거만 기록, 수정·삭제 불가)
model SchoolNoticeRevision {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId    String       @map("notice_id") @db.Uuid
  version     Int
  title       String
  body        String
  status      NoticeStatus
  exampleKey  String?      @map("example_key")
  changedById String?      @map("changed_by_id") @db.Uuid
  changedAt   DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)

  notice    SchoolNotice @relation(fields: [noticeId], references: [id], onDelete: Restrict, map: "school_notice_revisions_notice_fkey")
  changedBy User?        @relation(fields: [changedById], references: [id], onDelete: SetNull, map: "school_notice_revisions_changer_fkey")

  @@unique([noticeId, version], map: "school_notice_revisions_notice_version_key")
  @@map("school_notice_revisions")
}

/// 선택적 처리 이력(교직원 직접 입력, 실제 발송·수신 확인·공식 결재 아님, 개인정보 없음)
model NoticeHandlingRecord {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId         String              @map("notice_id") @db.Uuid
  schoolId         String              @map("school_id") @db.Uuid
  channel          NoticeChannelLabel?
  channelNote      String?             @map("channel_note")
  audienceCategory String?             @map("audience_category")
  sentByTeacher    Boolean             @default(false) @map("sent_by_teacher")
  sentAt           DateTime?           @map("sent_at") @db.Timestamptz(6)
  memo             String?
  recordedById     String?             @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  voidedAt         DateTime?           @map("voided_at") @db.Timestamptz(6)
  voidReason       String?             @map("void_reason")

  notice     SchoolNotice @relation(fields: [noticeId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict, map: "notice_handling_records_notice_school_fkey")
  recordedBy User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull, map: "notice_handling_records_recorder_fkey")

  @@index([noticeId, recordedAt], map: "notice_handling_records_notice_idx")
  @@map("notice_handling_records")
}
