# /etc/safe-school/pilot.env — 실제 학교 시범운영(실제 학교 검색·업무용 이메일 인증·공식 재난문자)
# 권한: sudo chown root:ss-pilot /etc/safe-school/pilot.env && sudo chmod 640 /etc/safe-school/pilot.env
# 실제 교직원 이메일 등 개인정보를 다루므로 이 파일과 서버 접근자를 최소화하세요.
NODE_ENV=production
PORT=5002
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DEPLOY_PROFILE=production
DEPLOY_DB_SCHEMA=safeschool_prod_pilot
DATABASE_URL=postgresql://ss_pilot:<비밀번호>@127.0.0.1:5432/safeschool?schema=safeschool_prod_pilot&connection_limit=5
SESSION_SECRET=<시범운영 전용 무작위 값 — 심사와 다르게>
APP_BASE_URL=https://<시범운영 호스트명>
# 학교알리미 공식 OpenAPI(학교 검색)
SCHOOLINFO_API_KEY=<학교알리미 인증키>
# 업무용 이메일 인증(실제 발송). console 은 운영에서 거부됨
MAIL_PROVIDER=resend
MAIL_API_KEY=<메일 서비스 키>
MAIL_FROM=SAFE SCHOOL <no-reply@<인증된 발신 도메인>>
# 공식 긴급재난문자(승인·응답 형식 확인 후에만 켜기). 모의 경보는 시범운영에서 시작 거부
# ALERT_PROVIDERS=mois_cbs
# MOIS_CBS_SERVICE_KEY=<재난안전데이터 공유플랫폼 인증키>
MOIS_CBS_INTERVAL_SEC=300
