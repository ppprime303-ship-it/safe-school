# /etc/safe-school/pilot.env — 국내 VPS 실제 학교 시범운영(앱 1개)
# 권한: sudo chown root:ss-pilot /etc/safe-school/pilot.env && sudo chmod 640 /etc/safe-school/pilot.env
# 실제 교직원 이메일 등 개인정보를 다루므로 이 파일과 서버 접근자를 최소화하세요. Git·채팅·화면 캡처에 올리지 마세요.
NODE_ENV=production
PORT=5000
# 아래 3가지는 시범운영(pilot)에서 코드가 강제합니다(다르면 시작 거부): 127.0.0.1 수신, Caddy 1단, 같은 서버 DB
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DEPLOY_PROFILE=production
DEPLOY_DB_SCHEMA=safeschool_prod_pilot
DATABASE_URL=postgresql://ss_pilot:<비밀번호>@127.0.0.1:5432/safeschool?schema=safeschool_prod_pilot&connection_limit=5
SESSION_SECRET=<시범운영 전용 무작위 값 48자 이상 — openssl rand -base64 48>
APP_BASE_URL=https://<시범운영 호스트명>
# 학교알리미 공식 OpenAPI(학교 검색). 없으면 저장된 목록으로만 검색(시작 시 경고)
SCHOOLINFO_API_KEY=<학교알리미 인증키>
# 발급받은 학교알리미 인증키가 시군구 지정을 요구하면 켬(공식 페이지는 '선택')
# SCHOOLINFO_SGG_REQUIRED=true
# 나이스 교육정보 개방 포털(공개 학교정보 조회 전용, 실제 응답 확인 전에는 비워 둠)
# NEIS_API_KEY=<나이스 개방 포털 인증키>
# 업무용 이메일 인증(실제 발송). 없으면 가입이 503으로 거부(시작 시 경고). console 은 운영에서 거부됨
MAIL_PROVIDER=resend
MAIL_API_KEY=<메일 서비스 키>
MAIL_FROM=SAFE SCHOOL <no-reply@<인증된 발신 도메인>>
# 공식 긴급재난문자(활용 승인 + 실제 응답 형식 확인 + 계약 수정 후에만 켜기). 모의 경보는 시범운영에서 시작 거부
# ALERT_PROVIDERS=mois_cbs
# MOIS_CBS_SERVICE_KEY=<재난안전데이터 공유플랫폼 인증키>
MOIS_CBS_INTERVAL_SEC=900
