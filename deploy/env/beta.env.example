# /etc/safe-school-beta/beta.env — Beta PILOT 2 전용(기존 Prototype의 /etc/safe-school/pilot.env 와 별개)
# 권한: sudo chown root:ss-beta /etc/safe-school-beta/beta.env && sudo chmod 640 /etc/safe-school-beta/beta.env
# 아래 값은 코드가 강제합니다(다르면 시작 거부, server/src/deploy/environment.ts). Git·채팅·화면 캡처에 올리지 마세요.
NODE_ENV=production
PORT=5100
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DEPLOY_PROFILE=beta
DEPLOY_DB_SCHEMA=safeschool_beta
DATABASE_URL=postgresql://ss_beta:<비밀번호>@127.0.0.1:5432/safeschool_beta?schema=safeschool_beta&connection_limit=3
SESSION_SECRET=<Beta 전용 무작위 값 48자 이상 — openssl rand -base64 48, Prototype 값 재사용 금지>
APP_BASE_URL=https://<Beta 호스트명>
# 사진 영구 저장 경로(릴리스 폴더 밖). systemd ReadWritePaths 와 같아야 합니다
INCIDENT_UPLOAD_DIR=/var/lib/safe-school-beta/uploads
# 데이터 구분: virtual_test(승인된 가상 데이터) | school_pilot(실제 학교 — 학교·개인정보 승인 후에만)
BETA_DATA_MODE=virtual_test
# 실제 학교 모드로 바꿀 때만 승인 후 true 로 설정합니다
# BETA_SCHOOL_PILOT_APPROVED=true
# 메일: 비워 두면 가입이 503으로 거부됩니다(가상 데이터 시연에는 시드 계정만 사용). 가상 데이터 모드에서 resend·gmail 은 시작 거부
# 실제 학교 모드에서만: MAIL_PROVIDER=gmail, GMAIL_SMTP_USER, GMAIL_SMTP_APP_PASSWORD (docs/beta2/release/gmail-setup.md)
# MAIL_PROVIDER=manual
# 학교 검색: 키가 없으면 저장된 목록으로만 검색. 키를 넣으면 시군구 필수 설정도 함께(2026-10-27 실제 응답 기준)
# SCHOOLINFO_API_KEY=<학교알리미 인증키>
# SCHOOLINFO_SGG_REQUIRED=true
# 공식 재난문자는 활용 승인·공식 명세 확인 전 시작 거부, 모의 경보도 시작 거부(docs/integrations/api-status-2026-11-02.md)
