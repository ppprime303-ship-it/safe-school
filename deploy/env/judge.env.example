# /etc/safe-school/judge.env — 공모전 심사 환경(가상 학교 2곳·계정 8개·모의 재난자료만)
# 권한: sudo chown root:ss-judge /etc/safe-school/judge.env && sudo chmod 640 /etc/safe-school/judge.env
NODE_ENV=production
PORT=5001
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DEPLOY_PROFILE=production
DEPLOY_DB_SCHEMA=safeschool_prod_judge
# 심사 전용 DB 계정(ss_judge — 시범운영 스키마 권한 없음, deploy/sql/roles.sql)
DATABASE_URL=postgresql://ss_judge:<비밀번호>@127.0.0.1:5432/safeschool?schema=safeschool_prod_judge&connection_limit=5
# 환경마다 다른 무작위 값(openssl rand -base64 48)
SESSION_SECRET=<심사 전용 무작위 값>
APP_BASE_URL=https://<심사 호스트명>
# 모의 재난자료만(심사 환경에서만 허용). 공식 API(mois_cbs)는 심사 환경에서 시작 거부
ALERT_PROVIDERS=mock
ALERT_MOCK_FEED=/srv/safe-school/judge/current/deploy/judge/mock-alerts.json
ALERT_COLLECT_INTERVAL_SEC=300
# 메일 미설정: 공개 가입 불가(심사 계정은 운영자가 judge:setup 으로 사전 구성)
