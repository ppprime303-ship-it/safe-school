# /etc/safe-school/safe-school.env 예시 — 실제 값은 서버에만 두고 저장소·채팅·문서에 적지 않습니다.
# 권한: sudo chown root:safeschool /etc/safe-school/safe-school.env && sudo chmod 640 /etc/safe-school/safe-school.env
NODE_ENV=production
PORT=5000
# 프록시만 외부에 열고 앱은 내부 주소에서만 받음(직접 접속·IP 위조 방지)
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DEPLOY_PROFILE=production
DEPLOY_DB_SCHEMA=safeschool_prod_judge
# 같은 서버의 PostgreSQL(외부 비공개). connection_limit 으로 연결 수 제한
DATABASE_URL=postgresql://safeschool_app:<비밀번호>@127.0.0.1:5432/safeschool?schema=safeschool_prod_judge&connection_limit=5
# 32자 이상 무작위: openssl rand -base64 48
SESSION_SECRET=<무작위 값>
APP_BASE_URL=https://<시연 도메인>
# 모의 경보는 운영 모드에서 거부됩니다(설정하지 않음)
# ALERT_MOCK_FEED=
# 메일 발송을 설정하지 않으면 공개 회원가입·인증코드는 동작하지 않습니다(심사 계정은 운영자가 사전 생성)
# MAIL_PROVIDER=
# DEPLOY_ALLOW_NEW_SCHEMA 는 여기에 넣지 않습니다(첫 생성 때 명령에만 일시 지정)
