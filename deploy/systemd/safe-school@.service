# /etc/systemd/system/safe-school@.service — 한 VPS에서 환경별 독립 실행(인스턴스 이름 = judge 또는 pilot)
#   sudo systemctl enable --now safe-school@judge   # 공모전 심사(가상 학교·모의 자료)
#   sudo systemctl enable --now safe-school@pilot   # 실제 학교 시범운영
# 환경마다 실행 계정·폴더·환경변수·로그가 따로입니다(한쪽 장애·재시작이 다른 쪽에 영향 없음).
[Unit]
Description=SAFE SCHOOL (%i)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
# 환경별 리눅스 계정(ss-judge / ss-pilot): 다른 환경의 env 파일·폴더를 읽지 못함
User=ss-%i
Group=ss-%i
WorkingDirectory=/srv/safe-school/%i/current
EnvironmentFile=/etc/safe-school/%i.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/deploy-start.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
# 메모리 상한(4GB 서버, 앱 2개 기준 예시 — 실측 후 조정)
MemoryMax=700M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/safe-school/%i
SyslogIdentifier=safe-school-%i

[Install]
WantedBy=multi-user.target
