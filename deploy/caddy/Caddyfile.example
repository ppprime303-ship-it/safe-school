# /etc/caddy/Caddyfile 예시 — <시연 도메인>을 실제 도메인으로 바꾸세요. Caddy가 HTTPS 인증서를 자동 발급·갱신합니다.
<시연 도메인> {
	encode zstd gzip
	# 보안 헤더(앱 코드 변경 없이 프록시에서 추가)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
	request_body {
		max_size 1MB
	}
	# Caddy는 X-Forwarded-For·X-Forwarded-Proto 를 자동으로 붙입니다(앱 TRUST_PROXY_HOPS=1)
	reverse_proxy 127.0.0.1:5000
	log {
		output file /var/log/caddy/safe-school-access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
