# /etc/caddy/Caddyfile — 한 VPS, 호스트명 2개(인증서 자동 발급·갱신). <…> 를 실제 값으로 바꾸세요.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
	request_body {
		max_size 1MB
	}
}

# 공모전 심사(가상 학교) → 앱 judge(5001)
<심사 호스트명> {
	import common
	reverse_proxy 127.0.0.1:5001
	log {
		output file /var/log/caddy/judge-access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}

# 실제 학교 시범운영 → 앱 pilot(5002). 접속 로그에는 IP·경로만(본문·쿠키 기록 안 함)
<시범운영 호스트명> {
	import common
	reverse_proxy 127.0.0.1:5002
	log {
		output file /var/log/caddy/pilot-access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
