{
  "name": "safe-school",
  "version": "0.1.0",
  "private": true,
  "description": "SAFE SCHOOL — 학교 재난안전 통합 업무지원 시스템",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "vite build && esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild scripts/deploy-start.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/deploy-start.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "deploy:start": "node dist/deploy-start.js",
    "deploy:check": "tsx scripts/deploy-start.ts --check",
    "deploy:migrate": "tsx scripts/deploy-start.ts --migrate-only",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/prepare-test-db.ts && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:summary": "tsx scripts/db-summary.ts",
    "db:backup": "bash scripts/backup.sh",
    "postinstall": "prisma generate",
    "operator": "tsx scripts/operator.ts",
    "directory:sync": "tsx scripts/sync-school-directory.ts",
    "schoolinfo:verify": "tsx scripts/verify-schoolinfo.ts",
    "e2e:step2": "tsx scripts/e2e-step2.ts",
    "e2e:step3": "tsx scripts/e2e-step3.ts",
    "e2e:step3b": "tsx scripts/e2e-step3b.ts",
    "e2e:step3c": "tsx scripts/e2e-step3c.ts",
    "e2e:step3d": "tsx scripts/e2e-step3d.ts",
    "e2e:step3e": "tsx scripts/e2e-step3e.ts",
    "alerts": "tsx scripts/alerts.ts",
    "judge:setup": "tsx scripts/judge-demo-setup.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
